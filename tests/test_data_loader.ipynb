"source": [
  "from pathlib import Path\n",
  "from FIT_python.config import RAW_DIR\n",
  "from FIT_python.data_import_utils import load_raw_files\n",
  "\n",
  "# 1) Specify the raw data directory\n",
  "raw_dir = RAW_DIR  # comes from config.py\n",
  "\n",
  "# 2) Load all raw files\n",
  "dfs = load_raw_files(raw_dir)\n",
  "\n",
  "# 3) Print shape of each DataFrame\n",
  "for name, df in dfs.items():\n",
  "    print(f\"DataFrame '{name}' shape: {df.shape}\")\n",
  "\n",
  "# 4) Display first 5 rows of each DataFrame\n",
  "for name, df in dfs.items():\n",
  "    print(f\"\\n{name} preview:\")\n",
  "    display(df.head())\n",
  "\n",
  "# 5) Split into meta/targets/features\n",
  "from FIT_python.config import DEFAULT_TARGETS, OTTER_META_COLS\n",
  "from FIT_python.data_import_utils import sanitize_labels\n",
  "\n",
  "default_targets = DEFAULT_TARGETS\n",
  "otter_meta      = OTTER_META_COLS\n",
  "\n",
  "# Build mapping dict\n",
  "col_maps = {}\n",
  "for name, df in dfs.items():\n",
  "    if name.lower().startswith('eurasian_otter'):\n",
  "        col_maps[name] = {'meta': otter_meta, 'targets': []}\n",
  "    else:\n",
  "        col_maps[name] = {'meta': ['id'], 'targets': default_targets}\n",
  "\n",
  "# Apply splits\n",
  "processed = {}\n",
  "for name, df in dfs.items():\n",
  "    meta_cols   = col_maps[name]['meta']\n",
  "    target_cols = col_maps[name]['targets']\n",
  "    meta_df     = df[meta_cols]\n",
  "    target_df   = df[target_cols] if target_cols else None\n",
  "    feature_cols= [c for c in df.columns if c not in meta_cols + target_cols]\n",
  "    X           = df[feature_cols].to_numpy()\n",
  "    processed[name] = {'meta_df': meta_df, 'target_df': target_df, 'X': X, 'features': feature_cols}\n",
  "\n",
  "# 6) Quick check\n",
  "for name, parts in processed.items():\n",
  "    print(f\"\\nDataset '{name}':\")\n",
  "    print(\"  Meta cols:   \", parts['meta_df'].columns.tolist())\n",
  "    if parts['target_df'] is not None:\n",
  "        print(\"  Target cols: \", parts['target_df'].columns.tolist())\n",
  "    print(\"  Features (#):\", len(parts['features']))\n",
  "    print(\"  X shape:     \", parts['X'].shape)\n",
  "\n",
  "# 7) Sanitize label columns (except trail)\n",
  "sex_map = {'f': 'female', 'm': 'male'}\n",
  "for name, df in dfs.items():\n",
  "    df_clean = sanitize_labels(df, target_cols=default_targets, skip_fillna=['trail'], mapping=sex_map)\n",
  "    print(f\"{name} unique sexes after cleaning:\", df_clean['sex'].unique())\n"
]

