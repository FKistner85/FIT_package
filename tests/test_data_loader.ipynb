   "source": [
    "# 1) Baue erst dein Landmark-Mapping wie bisher\n",
    "import json\n",
    "from pathlib import Path\n",
    "from FIT_python.config import OTTER_POINT_MAP_PATH\n",
    "\n",
    "feature_cols = results[\"Eurasian_Otter\"][\"feature_cols\"]\n",
    "\n",
    "# Spalte\u2192Info\n",
    "landmark_map = {}\n",
    "for col in feature_cols:\n",
    "    parts = col.split(\"_\")\n",
    "    key   = parts[0]            \n",
    "    nums  = [int(p) for p in parts[1:]]\n",
    "    landmark_map[col] = {\n",
    "        \"type\": key,\n",
    "        \"points\": nums\n",
    "    }\n",
    "\n",
    "# 2) Invertiere: Punkt\u2192Liste von Spalten\n",
    "point_map = {}\n",
    "for col, info in landmark_map.items():\n",
    "    for pt in info[\"points\"]:\n",
    "        point_map.setdefault(pt, []).append(col)\n",
    "\n",
    "# 3) Optional: als JSON speichern\n",
    "out = OTTER_POINT_MAP_PATH\n",
    "out.parent.mkdir(exist_ok=True, parents=True)\n",
    "import json\n",
    "with open(out, \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(point_map, f, indent=2)\n",
    "\n",
    "print(f\"Saved point\u2192features map to {out}\")\n",
    "# Welche Messungen enthalten Punkt 2?\n",
    "print(point_map[2])\n",
    "\n"
   ]
  }
