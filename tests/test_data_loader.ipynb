   "source": [
    "# test_notebook.ipynb \u2014 Single-file flow\n",
    "\n",
    "from pathlib import Path\n",
    "from FIT_python.config import RAW_DIR\n",
    "from FIT_python.pipeline import DataPipeline\n",
    "\n",
    "# 1) Specify single raw file\n",
    "raw_file = RAW_DIR / 'Eurasian Otter.csv'\n",
    "\n",
    "# 2) Build mapping for this one dataset\n",
    "default_targets   = ['species', 'animal', 'trail', 'sex']\n",
    "otter_extra_meta  = ['date', 'location', 'dataorigin', 'substrate']\n",
    "dataset_key       = raw_file.stem.replace(\" \", \"_\")\n",
    "\n",
    "col_mapping = {\n",
    "    dataset_key: {\n",
    "        \"meta\":    [\"id\"] + otter_extra_meta,\n",
    "        \"targets\": default_targets\n",
    "    }\n",
    "}\n",
    "\n",
    "# 3) Instantiate & run\n",
    "pipeline = DataPipeline(\n",
    "    raw_dir=None,\n",
    "    raw_file=raw_file,\n",
    "    col_mapping=col_mapping,\n",
    "    skip_fillna=[\"trail\"],\n",
    "    label_map={\"f\": \"female\", \"m\": \"male\"}\n",
    ")\n",
    "results = pipeline.run()\n",
    "\n",
    "# 4) Inspect only the one result\n",
    "parts = results[dataset_key]\n",
    "print(f\"Dataset: {dataset_key}\")\n",
    "print(\"  Meta cols:   \", parts[\"meta\"].columns.tolist())\n",
    "print(\"  Target cols: \", parts[\"target\"].columns.tolist())\n",
    "print(\"  Feature count:\", len(parts[\"feature_cols\"]))\n",
    "display(parts[\"features\"].head())\n"
   ]
  },
