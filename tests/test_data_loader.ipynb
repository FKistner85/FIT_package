   "source": [
    "# test_notebook.ipynb \u2014 Full-folder flow\n",
    "\n",
    "from pathlib import Path\n",
    "from FIT_python.config import RAW_DIR\n",
    "from FIT_python.pipeline import DataPipeline\n",
    "from FIT_python.data_import_utils import load_raw_files\n",
    "\n",
    "# 1) Load all raw DataFrames\n",
    "raw_dir = RAW_DIR\n",
    "dfs = load_raw_files(raw_dir)\n",
    "\n",
    "# 2) Define meta/targets mapping for each dataset\n",
    "default_targets = ['species', 'animal', 'trail', 'sex']\n",
    "otter_extra_meta = ['date', 'location', 'dataorigin', 'substrate']\n",
    "\n",
    "col_mapping = {}\n",
    "for name in dfs:\n",
    "    meta = [\"id\"]\n",
    "    if \"otter\" in name.lower():\n",
    "        meta += otter_extra_meta\n",
    "    col_mapping[name] = {\"meta\": meta, \"targets\": default_targets}\n",
    "\n",
    "# 3) Instantiate & run\n",
    "pipeline = DataPipeline(\n",
    "    raw_dir=raw_dir,\n",
    "    raw_file=None,\n",
    "    col_mapping=col_mapping,\n",
    "    skip_fillna=[\"trail\"],\n",
    "    label_map={\"f\": \"female\", \"m\": \"male\"}\n",
    ")\n",
    "results = pipeline.run()\n",
    "\n",
    "# 4) Inspect\n",
    "for name, parts in results.items():\n",
    "    print(f\"Dataset: {name}\")\n",
    "    print(\"  Meta cols:   \", parts[\"meta\"].columns.tolist())\n",
    "    print(\"  Target cols: \", parts[\"target\"].columns.tolist())\n",
    "    print(\"  Feature count:\", len(parts[\"feature_cols\"]))\n",
    "    display(parts[\"features\"].head())\n",
    "    print(\"-\" * 50)\n"
   ]
  },
