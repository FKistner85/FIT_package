    "\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from IPython.display import Markdown, display\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import balanced_accuracy_score\n",
    "\n",
    "from FIT_python.config import SPLITS_DIR\n",
    "from FIT_python.data_split_and_summary.data_import_utils import get_feature_cols\n",
    "from FIT_python.pipeline_individual_id.generate_trails_and_trailpairs import generate_pairwise_comparisons_from_df\n",
    "from FIT_python.pipeline_individual_id.pairwise_individual_id_pipeline import run_all_pairwise_projections_parallel\n",
    "from FIT_python.pipeline_individual_id.evaluation import (\n",
    "    compute_overlap_jsl_style,\n",
    "    compute_overlap_jsl_style_isotropic,\n",
    "    compute_overlap_pooled,\n",
    "    compute_confusion,\n",
    "    compute_bcr,\n",
    ")\n",
    "\n",
    "P_VALUES = np.linspace(0.1, 1.0, 50)\n",
    "methods = [\n",
    "    ('Elliptic', compute_overlap_jsl_style),\n",
    "    ('Isotropic', compute_overlap_jsl_style_isotropic),\n",
    "    ('PooledIso', compute_overlap_pooled),\n",
    "]\n",
    "\n",
    "best_p = {}\n",
    "cv_base = EXP_DIR / 'fold_cv'\n",
    "for sp_dir in sorted(cv_base.iterdir()):\n",
    "    if not sp_dir.is_dir():\n",
    "        continue\n",
    "    df_cv = pd.read_csv(sp_dir / 'all_folds.csv')\n",
    "    folds = df_cv['fold'].astype(int).to_numpy()\n",
    "    best_p[sp_dir.name] = {}\n",
    "    for name, func in methods:\n",
    "        bp, ba = None, -1.0\n",
    "        for p in P_VALUES:\n",
    "            accs = []\n",
    "            for f in np.unique(folds):\n",
    "                sub = df_cv[folds == f]\n",
    "                preds = sub.apply(func, axis=1, p=p)\n",
    "                accs.append(balanced_accuracy_score(sub['same_individual'], preds))\n",
    "            macc = np.mean(accs)\n",
    "            if macc > ba:\n",
    "                ba, bp = macc, p\n",
    "        best_p[sp_dir.name][name] = bp\n",
    "\n",
    "for sp_dir in sorted(SPLITS_DIR.iterdir()):\n",
    "    if not sp_dir.is_dir():\n",
    "        continue\n",
    "    display(Markdown(f\"## {sp_dir.name.replace('_', ' ').title()}\"))\n",
    "    train_df = pd.read_parquet(sp_dir / 'train.parquet')\n",
    "    test_df = pd.read_parquet(sp_dir / 'test.parquet')\n",
    "    if 'trail' in train_df.columns and 'Trail' not in train_df.columns:\n",
    "        train_df = train_df.rename(columns={'trail': 'Trail'})\n",
    "    if 'trail' in test_df.columns and 'Trail' not in test_df.columns:\n",
    "        test_df = test_df.rename(columns={'trail': 'Trail'})\n",
    "    if 'Fold' in train_df.columns and 'fold' not in train_df.columns:\n",
    "        train_df = train_df.rename(columns={'Fold': 'fold'})\n",
    "    if 'Fold' in test_df.columns and 'fold' not in test_df.columns:\n",
    "        test_df = test_df.rename(columns={'Fold': 'fold'})\n",
    "\n",
    "    feature_cols = get_feature_cols(train_df)\n",
    "\n",
    "    comps_tr, _ = generate_pairwise_comparisons_from_df(\n",
    "        train_df, trail_col='Trail', id_col='individual_id', fold_col='fold')\n",
    "    res_tr = run_all_pairwise_projections_parallel(\n",
    "        comps_tr, train_df, feature_cols=feature_cols\n",
    "    )\n",
    "    df_tr_pairs = pd.DataFrame(res_tr)\n",
    "    dist_cols = [c for c in df_tr_pairs.columns if c.startswith(('dist_','mean_','median_'))]\n",
    "    X_tr = df_tr_pairs[dist_cols].to_numpy()\n",
    "    y_tr = df_tr_pairs['same_individual'].map({True:1, False:0}).to_numpy()\n",
    "    scaler = StandardScaler().fit(X_tr)\n",
    "    clf = LogisticRegression(penalty='l1', solver='liblinear', max_iter=1000).fit(scaler.transform(X_tr), y_tr)\n",
    "\n",
    "    comps_te, _ = generate_pairwise_comparisons_from_df(\n",
    "        test_df, trail_col='Trail', id_col='individual_id', fold_col='fold')\n",
    "    full_df = pd.concat([train_df, test_df], ignore_index=True)\n",
    "    res_te = run_all_pairwise_projections_parallel(\n",
    "        comps_te, full_df, feature_cols=feature_cols\n",
    "    )\n",
    "    pairs_df = pd.DataFrame(res_te)\n",
    "\n",
    "    for name, func in methods:\n",
    "        p = best_p.get(sp_dir.name, {}).get(name)\n",
    "        if p is not None:\n",
    "            pairs_df[f'pred_{name}'] = pairs_df.apply(func, axis=1, p=p)\n",
    "\n",
    "    if dist_cols:\n",
    "        X_te = pairs_df[dist_cols].to_numpy()\n",
    "        pairs_df['pred_DistClf'] = clf.predict(scaler.transform(X_te))\n",
    "\n",
    "    for col in [f'pred_{m}' for m,_ in methods] + ['pred_DistClf']:\n",
    "        if col in pairs_df.columns:\n",
    "            cm = compute_confusion(pairs_df, true_col='same_individual', pred_col=col)\n",
    "            bcr = compute_bcr(cm)\n",
    "            display(Markdown(f'**{col} \u2013 BCR={bcr:.2f}**'))\n",
    "            display(cm)\n",
