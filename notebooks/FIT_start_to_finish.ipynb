    "# %% Test Evaluation using Best Parameters\n",
    "from FIT_python.pipeline_individual_id.generate_trails_and_trailpairs import generate_pairwise_comparisons_from_df\n",
    "from FIT_python.pipeline_individual_id.evaluation import (\n",
    "    compute_overlap_jsl_style,\n",
    "    compute_overlap_jsl_style_isotropic,\n",
    ")\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "TEST_SPLIT_DIR = Path(\"data/splits\")\n",
    "methods = [\n",
    "    (\"elliptic\", compute_overlap_jsl_style),\n",
    "    (\"isotropic\", compute_overlap_jsl_style_isotropic),\n",
    "    (\"pooled_iso\", compute_overlap_pooled),\n",
    "]\n",
    "\n",
    "for species_dir in sorted(TEST_SPLIT_DIR.iterdir()):\n",
    "    if not species_dir.is_dir():\n",
    "        continue\n",
    "    print(f\"=== {species_dir.name} ===\")\n",
    "    df_train = pd.read_parquet(species_dir / \"train.parquet\")\n",
    "    df_test = pd.read_parquet(species_dir / \"test.parquet\")\n",
    "\n",
    "    comps_test, _ = generate_pairwise_comparisons_from_df(df_test, trail_col=\"Trail\", fold_col=\"fold\")\n",
    "    df_pairs = pd.DataFrame(comps_test)\n",
    "\n",
    "    best_p_values = best_p_by_species.get(species_dir.name)\n",
    "    results_test = {}\n",
    "    for name, func in methods:\n",
    "        p_best = None if best_p_values is None else best_p_values.get(name)\n",
    "        if p_best is not None:\n",
    "            df_pairs[f\"pred_{name}\"] = df_pairs.apply(func, axis=1, p=p_best)\n",
    "            cm_df = compute_confusion_df(\n",
    "                df_pairs[\"same_individual\"].map({True:1, False:0}),\n",
    "                df_pairs[f\"pred_{name}\"].map({True:1, False:0})\n",
    "            )\n",
    "            results_test[name] = cm_df\n",
    "\n",
    "    scaler = scalers.get(species_dir.name)\n",
    "    clf = clfs.get(species_dir.name)\n",
    "    if scaler is not None and clf is not None:\n",
    "        dist_cols = [c for c in df_pairs.columns if c.startswith((\"dist_\",\"mean_\",\"median_\"))]\n",
    "        X_test = df_pairs[dist_cols].to_numpy()\n",
    "        y_test = df_pairs[\"same_individual\"].map({True:1, False:0}).to_numpy()\n",
    "        X_scaled = scaler.transform(X_test)\n",
    "        y_pred = clf.predict(X_scaled)\n",
    "        cm_clf = compute_confusion_df(y_test, y_pred)\n",
    "        results_test[\"dist_clf\"] = cm_clf\n",
    "\n",
    "    fig, axes = plt.subplots(1, 4, figsize=(18,4))\n",
    "    for ax, (name, cm_df) in zip(axes, results_test.items()):\n",
    "        cm_norm = cm_df.divide(cm_df.sum(axis=1), axis=0)\n",
    "        sns.heatmap(cm_norm, annot=cm_df, fmt=\"d\", cmap=\"Blues\",\n",
    "                    xticklabels=cm_df.columns, yticklabels=cm_df.index,\n",
    "                    cbar=False, ax=ax)\n",
    "        ax.set_title(f\"{species_dir.name}\n",
    "{name}\")\n",
    "        ax.set_xlabel(\"Predicted\")\n",
    "        ax.set_ylabel(\"True\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    for name, cm_df in results_test.items():\n",
    "        print(f\"{name} confusion matrix:\n",
    "{cm_df}\n",
    "\")\n"
