    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "from IPython.display import display, Markdown, Image\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from FIT_python.general_pipeline_steps.dimensionality_reduction_wrapper import DimensionalityReducerTransformer\n",
    "from FIT_python.general_pipeline_steps.outlier_wrapper import mark_outliers_centroid, print_filter_stats\n",
    "from FIT_python.Visualisations.plots_utils import plot_umap_centroid_outliers\n",
    "\n",
    "# ▶️ Complete Notebook Block: Iterative UMAP Retraining + Centroid‑Outlier Filtering\n",
    "\n",
    "# --- 0) Load & preprocess train split ---\n",
    "split_dir = Path(SPLITS_DIR) / \"eurasian_otter\"\n",
    "train_df  = pd.read_parquet(split_dir / \"train.parquet\")\n",
    "train_df[\"sex_mapped\"] = map_sex(train_df[\"sex\"])\n",
    "\n",
    "# select only feature columns\n",
    "meta_cols   = [\"id\",\"species\",\"individual_id\",\"date\",\"location\",\n",
    "               \"dataorigin\",\"substrate\",\"sex\",\"trail\",\"Fold\",\"sex_mapped\"]\n",
    "feature_cols = [c for c in train_df.columns if c not in meta_cols]\n",
    "\n",
    "# --- Define filter stages ---\n",
    "stages = [\n",
    "    (\"Original (no filter)\", None),\n",
    "    (\"Coarse   (20%)\",         10),\n",
    "    (\"Fine     (5%)\",           2),\n",
    "    (\"VeryFine (1%)\",           1),\n",
    "]\n",
    "\n",
    "# we'll keep track of the reducer and the \"current\" embedding DataFrame\n",
    "current_df = None\n",
    "current_reducer = None\n",
    "\n",
    "for stage_name, pct in stages:\n",
    "    if pct is None:\n",
    "        # 1) Initial UMAP on full data\n",
    "        current_reducer = DimensionalityReducerTransformer(method='umap', n_components=2)\n",
    "        emb = current_reducer.fit_transform(train_df[feature_cols])\n",
    "        current_df = pd.DataFrame(emb, columns=[\"UMAP1\",\"UMAP2\"])\n",
    "        current_df[[\"individual_id\",\"sex_mapped\"]] = train_df[[\"individual_id\",\"sex_mapped\"]]\n",
    "    else:\n",
    "        # 2) Mark & remove outliers per individual\n",
    "        flagged_frames = []\n",
    "        for ind, grp in current_df.groupby(\"individual_id\"):\n",
    "            flagged = mark_outliers_centroid(grp, bandwidth=0.5, percentile=pct)\n",
    "            flagged_frames.append(flagged)\n",
    "        flagged_df = pd.concat(flagged_frames)\n",
    "        cleaned_df = flagged_df.loc[~flagged_df[\"is_outlier_centroid\"], [\"UMAP1\",\"UMAP2\",\"individual_id\",\"sex_mapped\"]]\n",
    "        \n",
    "        # 3) Print filter stats\n",
    "        print_filter_stats(f\"Train: {stage_name}\", current_df, cleaned_df)\n",
    "        \n",
    "        # 4) Retrain UMAP on cleaned data\n",
    "        current_reducer = DimensionalityReducerTransformer(method='umap', n_components=2)\n",
    "        emb = current_reducer.fit_transform(\n",
    "            train_df.loc[cleaned_df.index, feature_cols]\n",
    "        )\n",
    "        current_df = pd.DataFrame(emb, columns=[\"UMAP1\",\"UMAP2\"])\n",
    "        current_df[[\"individual_id\",\"sex_mapped\"]] = cleaned_df[[\"individual_id\",\"sex_mapped\"]]\n",
    "        flagged_df = flagged_df  # keep for visualization below\n",
    "\n",
    "    # 5) Visualize at this stage\n",
    "    display(Markdown(f\"## UMAP–Train {stage_name}\"))\n",
    "    if pct is None:\n",
    "        # no outlier overlay\n",
    "        fig = plot_umap_centroid_outliers(\n",
    "            current_df.assign(is_outlier_centroid=False),\n",
    "            f\"Train – {stage_name}\"\n",
    "        )\n",
    "    else:\n",
    "        fig = plot_umap_centroid_outliers(\n",
    "            flagged_df,\n",
    "            f\"Train – {stage_name}\"\n",
    "        )\n",
    "    display(fig)\n",
    "    plt.close(fig)\n"
   ]
  },
