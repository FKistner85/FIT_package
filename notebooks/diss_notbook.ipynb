   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from itertools import combinations, cycle\n",
    "from matplotlib.patches import Circle\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "from FIT_python.general_pipeline_steps.dimensionality_reduction_wrapper import DimensionalityReducerTransformer\n",
    "from FIT_python.general_pipeline_steps.outlier_wrapper import mark_outliers_centroid\n",
    "from FIT_python.Visualisations.plots_utils import SEX_COLORS\n",
    "\n",
    "def per_trail_inliers(df_emb: pd.DataFrame, pct: float):\n",
    "    \"\"\"Apply centroid-based outlier filtering separately to each trail.\"\"\"\n",
    "    inliers = []\n",
    "    for trail, grp in df_emb.groupby(\"trail\"):\n",
    "        flagged = mark_outliers_centroid(grp, bandwidth=0.5, percentile=pct)\n",
    "        inliers.append(grp.loc[~flagged[\"is_outlier_centroid\"]])\n",
    "    return pd.concat(inliers)\n",
    "\n",
    "def compute_centroids_dists(inliers_df):\n",
    "    \"\"\"Compute centroid and mean distance to centroid per trail.\"\"\"\n",
    "    cents, dists = {}, {}\n",
    "    for trail, grp in inliers_df.groupby(\"trail\"):\n",
    "        pts = grp[[\"UMAP1\",\"UMAP2\"]].values\n",
    "        c = pts.mean(axis=0)\n",
    "        cents[trail] = c\n",
    "        dists[trail] = np.linalg.norm(pts - c, axis=1).mean()\n",
    "    return cents, dists\n",
    "\n",
    "def eval_sigma(sigma, cents, dists, inliers_df, lambda_=1.0):\n",
    "    \"\"\"\n",
    "    Compute combined score = coverage - lambda*overlap\n",
    "    Coverage = fraction of inlier points within their trail's circle.\n",
    "    Overlap = fraction of trail‐pairs whose circles overlap.\n",
    "    \"\"\"\n",
    "    radii = {t: sigma * dists[t] for t in cents}\n",
    "    covered = 0\n",
    "    for trail, grp in inliers_df.groupby(\"trail\"):\n",
    "        cx, cy = cents[trail]\n",
    "        covered += (np.hypot(grp[\"UMAP1\"] - cx, grp[\"UMAP2\"] - cy) <= radii[trail]).sum()\n",
    "    alpha = covered / len(inliers_df)\n",
    "    pairs = list(combinations(cents.keys(), 2))\n",
    "    overlap = sum(\n",
    "        np.linalg.norm(cents[a] - cents[b]) < (radii[a] + radii[b])\n",
    "        for a, b in pairs\n",
    "    )\n",
    "    beta = overlap / len(pairs)\n",
    "    return alpha - lambda_*beta, alpha, beta\n",
    "\n",
    "# --- Load & preprocess ---\n",
    "split_dir = Path(SPLITS_DIR) / \"eurasian_otter\"\n",
    "train_df  = pd.read_parquet(split_dir / \"train.parquet\")\n",
    "test_df   = pd.read_parquet(split_dir / \"test.parquet\")\n",
    "\n",
    "for df in (train_df, test_df):\n",
    "    df[\"sex_mapped\"] = map_sex(df[\"sex\"])\n",
    "\n",
    "# --- UMAP fit on train & transform on test ---\n",
    "feature_cols = [c for c in train_df.columns\n",
    "                if c not in [\"id\",\"species\",\"individual_id\",\"date\",\"location\",\n",
    "                             \"dataorigin\",\"substrate\",\"sex\",\"trail\",\"Fold\",\"sex_mapped\"]]\n",
    "reducer   = DimensionalityReducerTransformer(method='umap', n_components=2)\n",
    "emb_train = reducer.fit_transform(train_df[feature_cols])\n",
    "emb_test  = reducer.transform(test_df[feature_cols])\n",
    "\n",
    "train_emb_df = pd.DataFrame(emb_train, columns=[\"UMAP1\",\"UMAP2\"])\n",
    "train_emb_df[[\"trail\",\"individual_id\",\"sex_mapped\"]] = train_df[[\"trail\",\"individual_id\",\"sex_mapped\"]]\n",
    "test_emb_df  = pd.DataFrame(emb_test,  columns=[\"UMAP1\",\"UMAP2\"])\n",
    "test_emb_df[[\"trail\",\"individual_id\",\"sex_mapped\"]]  = test_df[[\"trail\",\"individual_id\",\"sex_mapped\"]]\n",
    "\n",
    "# --- Per-trail very-fine inliers (1%) ---\n",
    "pct = 1\n",
    "train_inliers = per_trail_inliers(train_emb_df, pct)\n",
    "test_inliers  = per_trail_inliers(test_emb_df,  pct)\n",
    "\n",
    "# --- Compute stats on train & grid-search best sigma ---\n",
    "train_cents, train_dists = compute_centroids_dists(train_inliers)\n",
    "sigmas = np.linspace(0.5, 3.0, 26)\n",
    "results = [(s, *eval_sigma(s, train_cents, train_dists, train_inliers)) for s in sigmas]\n",
    "best_sigma, best_score, best_alpha, best_beta = max(results, key=lambda x: x[1])\n",
    "print(f\"Optimal σ (Train) = {best_sigma:.2f}: Score={best_score:.3f}, Coverage={best_alpha:.3f}, Overlap={best_beta:.3f}\")\n",
    "\n",
    "# --- Compute stats on test ---\n",
    "test_cents, test_dists = compute_centroids_dists(test_inliers)\n",
    "\n",
    "# --- Evaluate confusion on test trails ---\n",
    "rows = []\n",
    "for a, b in combinations(test_cents.keys(), 2):\n",
    "    ca, cb = test_cents[a], test_cents[b]\n",
    "    ra, rb = best_sigma * test_dists[a], best_sigma * test_dists[b]\n",
    "    ovl = np.linalg.norm(ca - cb) < (ra + rb)\n",
    "    same = (\n",
    "        test_emb_df.loc[test_emb_df[\"trail\"] == a,   \"individual_id\"].iat[0]\n",
    "        == test_emb_df.loc[test_emb_df[\"trail\"] == b, \"individual_id\"].iat[0]\n",
    "    )\n",
    "    rows.append({\"trail_a\": a, \"trail_b\": b, \"same\": same, \"ovl\": ovl})\n",
    "res = pd.DataFrame(rows)\n",
    "tp = len(res[(res.same) & (res.ovl)])\n",
    "fn = len(res[(res.same) & (~res.ovl)])\n",
    "fp = len(res[(~res.same) & (res.ovl)])\n",
    "tn = len(res[(~res.same) & (~res.ovl)])\n",
    "print(\"Test Confusion:\")\n",
    "print(f\" TP: {tp}, FN: {fn}, FP: {fp}, TN: {tn}\")\n",
    "\n",
    "# --- Plot Train & Test ---\n",
    "for name, inliers_df, cents, dists in [\n",
    "    (\"Train\", train_inliers, train_cents, train_dists),\n",
    "    (\"Test\",  test_inliers,  test_cents,  test_dists),\n",
    "]:\n",
    "    plt.figure(figsize=(6,6))\n",
    "    plt.title(f\"{name} UMAP – σ={best_sigma:.2f}\")\n",
    "    marker_map = {\n",
    "        t: m for t, m in zip(\n",
    "            inliers_df[\"trail\"].unique(),\n",
    "            cycle(['o','s','^','v','P','X','D','*','h','+'])\n",
    "        )\n",
    "    }\n",
    "    for trail, grp in inliers_df.groupby(\"trail\"):\n",
    "        plt.scatter(\n",
    "            grp[\"UMAP1\"], grp[\"UMAP2\"],\n",
    "            marker=marker_map[trail],\n",
    "            c=[{'Female':'red','Male':'blue'}[s] for s in grp[\"sex_mapped\"]],\n",
    "            edgecolor='k', s=30, alpha=0.6\n",
    "        )\n",
    "        cx, cy = cents[trail]\n",
    "        circle = Circle(\n",
    "            (cx, cy),\n",
    "            best_sigma * dists[trail],\n",
    "            fill=False, edgecolor='black',\n",
    "            linewidth=0.5, alpha=0.7\n",
    "        )\n",
    "        plt.gca().add_patch(circle)\n",
    "    plt.xlabel(\"UMAP1\")\n",
    "    plt.ylabel(\"UMAP2\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
  },
