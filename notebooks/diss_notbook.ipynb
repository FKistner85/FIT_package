    "# ▶️ Complete Notebook Block: UMAP + Centroid‑Outlier Visualizations for Train, Test & Inference\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "from IPython.display import display, Markdown, Image\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from FIT_python.general_pipeline_steps.dimensionality_reduction_wrapper import DimensionalityReducerTransformer\n",
    "from FIT_python.general_pipeline_steps.outlier_wrapper import mark_outliers_centroid, print_filter_stats\n",
    "from FIT_python.Visualisations.plots_utils import plot_umap_centroid_outliers\n",
    "\n",
    "# --- 0) Load & preprocess splits & inference ---\n",
    "split_dir = Path(SPLITS_DIR) / \"eurasian_otter\"\n",
    "train_df  = pd.read_parquet(split_dir / \"train.parquet\")\n",
    "test_df   = pd.read_parquet(split_dir / \"test.parquet\")\n",
    "inf_df    = pd.read_parquet(split_dir / \"inference.parquet\")\n",
    "\n",
    "for df in (train_df, test_df, inf_df):\n",
    "    df[\"sex_mapped\"] = map_sex(df[\"sex\"])\n",
    "# inference uses 'trail' as individual_id\n",
    "inf_df[\"individual_id\"] = inf_df[\"trail\"]\n",
    "\n",
    "# 1) Select feature columns\n",
    "meta_cols    = [\"id\",\"species\",\"individual_id\",\"date\",\"location\",\"dataorigin\",\"substrate\",\"sex\",\"trail\",\"Fold\"]\n",
    "feature_cols = [c for c in train_df.columns if c not in meta_cols + [\"sex_mapped\"]]\n",
    "\n",
    "# 2) Fit UMAP reducer on train, then transform all sets\n",
    "reducer    = DimensionalityReducerTransformer(method='umap', n_components=2)\n",
    "emb_train  = reducer.fit_transform(train_df[feature_cols])\n",
    "emb_test   = reducer.transform(test_df[feature_cols])\n",
    "emb_inf    = reducer.transform(inf_df[feature_cols])\n",
    "\n",
    "data_dict = {\n",
    "    \"Train\":    (train_df, emb_train),\n",
    "    \"Test\":     (test_df,  emb_test),\n",
    "    \"Inference\":(inf_df,   emb_inf),\n",
    "}\n",
    "\n",
    "# 3) Define filter thresholds\n",
    "thresholds = {\n",
    "    \"Original\":      None,\n",
    "    \"Coarse (20%)\":  20,\n",
    "    \"Fine (5%)\":     5,\n",
    "    \"Very Fine (1%)\":1\n",
    "}\n",
    "\n",
    "# 4) Loop over each dataset and threshold, visualize and print stats\n",
    "for name, (orig_df, emb) in data_dict.items():\n",
    "    # Build embedding DataFrame\n",
    "    emb_df = pd.DataFrame(emb, columns=['UMAP1','UMAP2'])\n",
    "    emb_df[['individual_id','sex_mapped']] = orig_df[['individual_id','sex_mapped']]\n",
    "    \n",
    "    display(Markdown(f\"## {name} Set Visualizations\"))\n",
    "    \n",
    "    prev_df = emb_df.copy()\n",
    "    for stage, pct in thresholds.items():\n",
    "        if pct is None:\n",
    "            # Original\n",
    "            df_stage = prev_df\n",
    "            title    = f\"{name} – {stage}\"\n",
    "        else:\n",
    "            # Apply centroid-based outlier filter\n",
    "            df_flagged = mark_outliers_centroid(prev_df, bandwidth=0.5, percentile=pct)\n",
    "            df_stage   = df_flagged.loc[~df_flagged['is_outlier_centroid']].drop(\n",
    "                            columns=['centroid_density','is_outlier_centroid'])\n",
    "            title      = f\"{name} – {stage}\"\n",
    "        \n",
    "        # Visualization\n",
    "        fig = plot_umap_centroid_outliers(\n",
    "            df_stage.assign(is_outlier_centroid = False) if pct is None\n",
    "            else df_flagged,\n",
    "            title\n",
    "        )\n",
    "        display(fig)\n",
    "        \n",
    "        # Save if desired\n",
    "        # fig.savefig(fig_dir / f\"umap_{name.lower()}_{stage.replace(' ', '_')}.png\", dpi=150)\n",
    "        plt.close(fig)\n",
    "        \n",
    "        # Print stats\n",
    "        if pct is not None:\n",
    "            print_filter_stats(\n",
    "                f\"{name}: {stage}\",\n",
    "                prev_df,\n",
    "                df_stage\n",
    "            )\n",
    "        # Set prev_df for next iteration\n",
    "        prev_df = df_stage.copy()\n"
   ]
