    "# ▶️ UMAP + Iterative Centroid‑Outlier Filtering via Presets for Train, Test & Inference\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "from IPython.display import display, Markdown\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.pipeline import Pipeline\n",
    "\n",
    "from FIT_python.general_pipeline_steps.outlier_wrapper import OUTLIER_PRESETS, print_filter_stats\n",
    "from FIT_python.Visualisations.plots_utils import plot_umap_centroid_outliers\n",
    "from FIT_python.general_pipeline_steps.dimensionality_reduction_wrapper import DimensionalityReducerTransformer\n",
    "\n",
    "# --- 0) Load & preprocess splits & inference ---\n",
    "split_dir = Path(SPLITS_DIR) / \"eurasian_otter\"\n",
    "train_df  = pd.read_parquet(split_dir / \"train.parquet\")\n",
    "test_df   = pd.read_parquet(split_dir / \"test.parquet\")\n",
    "inf_df    = pd.read_parquet(split_dir / \"inference.parquet\")\n",
    "\n",
    "for df in (train_df, test_df, inf_df):\n",
    "    df[\"sex_mapped\"] = map_sex(df[\"sex\"])\n",
    "# inference uses 'trail' as individual_id\n",
    "inf_df[\"individual_id\"] = inf_df[\"trail\"]\n",
    "\n",
    "# 1) Select feature columns\n",
    "meta_cols    = [\"id\",\"species\",\"individual_id\",\"date\",\"location\",\n",
    "                \"dataorigin\",\"substrate\",\"sex\",\"trail\",\"Fold\",\"sex_mapped\"]\n",
    "feature_cols = [c for c in train_df.columns if c not in meta_cols]\n",
    "\n",
    "# 2) Prepare data dict\n",
    "data_dict = {\n",
    "    \"Train\":     train_df,\n",
    "    \"Test\":      test_df,\n",
    "    \"Inference\": inf_df,\n",
    "}\n",
    "\n",
    "# 3) Choose the pipelines (presets) to apply\n",
    "#    You can swap in any key from OUTLIER_PRESETS here\n",
    "stages = {\n",
    "    \"Original (UMAP only)\":         Pipeline([\n",
    "        (\"umap\",   DimensionalityReducerTransformer(method=\"umap\", n_components=2))\n",
    "    ]),\n",
    "    \"Coarse→Fine→VeryFine\":         OUTLIER_PRESETS[\"umap_centroid_1pct\"],\n",
    "    \"Supervised Coarse→…→VeryFine\":  OUTLIER_PRESETS[\"umap_centroid_iterative\"],\n",
    "    \"Hybrid Coarse→…→VeryFine\":      OUTLIER_PRESETS[\"sup_umap_centroid_iterative\"],\n",
    "}\n",
    "\n",
    "# 4) Loop over each dataset & each preset\n",
    "for name, df in data_dict.items():\n",
    "    display(Markdown(f\"## {name} Set: Iterative Filtering via Presets\"))\n",
    "    X = df[feature_cols]\n",
    "    y = df[\"individual_id\"]  # used by supervised‑UMAP presets\n",
    "\n",
    "    for stage_name, pipe in stages.items():\n",
    "        display(Markdown(f\"### {stage_name}\"))\n",
    "\n",
    "        # Fit on train only if supervised component exists\n",
    "        if \"sup_umap\" in stage_name.lower() or name == \"Train\":\n",
    "            emb = pipe.fit_transform(X, y) if hasattr(pipe, \"fit_transform\") else pipe.fit(X, y).transform(X)\n",
    "        else:\n",
    "            # for Test & Inference with unsupervised or already‑fit pipeline\n",
    "            emb = pipe.transform(X)\n",
    "\n",
    "        # Build embedding DataFrame\n",
    "        emb_df = pd.DataFrame(emb, columns=[\"UMAP1\",\"UMAP2\"], index=df.index)\n",
    "        emb_df[[\"individual_id\",\"sex_mapped\"]] = df[[\"individual_id\",\"sex_mapped\"]]\n",
    "\n",
    "        # Plot – pipelines with drop=True have already removed outliers\n",
    "        fig = plot_umap_centroid_outliers(emb_df, f\"{name} – {stage_name}\")\n",
    "        display(fig)\n",
    "        plt.close(fig)\n",
    "\n",
    "        # If the pipeline flags but does not drop, print stats\n",
    "        if hasattr(pipe, \"named_steps\") and \"centroid\" in pipe.named_steps:\n",
    "            # reconstruct pre/post df for stats\n",
    "            flagged = pipe.named_steps[\"centroid\"].transform(\n",
    "                emb_df.assign(UMAP1=emb_df[\"UMAP1\"], UMAP2=emb_df[\"UMAP2\"])\n",
    "            )\n",
    "            before = emb_df\n",
    "            after  = flagged.loc[~flagged[\"is_outlier_centroid\"]]\n",
    "            print_filter_stats(f\"{name}: {stage_name}\", before, after)\n"
   ]
  },
